<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily JobPilot run on macOS. Copy to ~/Library/LaunchAgents/com.jobpilot.daily.plist,
     fix the two paths, then: launchctl load ~/Library/LaunchAgents/com.jobpilot.daily.plist
     Stop it with: launchctl unload <same file>. Logs: <JOBPILOT_HOME>/data/daily.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobpilot.daily</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/path/to/jobpilot/scripts/daily.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>JOBPILOT_HOME</key><string>/path/to/jobpilot</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
