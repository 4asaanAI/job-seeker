{
  "mcpServers": {
    "jobpilot": {
      "command": "C:\\path\\to\\jobpilot\\.venv\\Scripts\\python.exe",
      "args": ["-m", "jobpilot.server"],
      "env": {
        "JOBPILOT_HOME": "C:\\path\\to\\jobpilot",
        "JOBPILOT_DB": "C:\\path\\to\\jobpilot\\data\\jobpilot.db",
        "JOBPILOT_OUT": "C:\\path\\to\\jobpilot\\out"
      }
    }
  }
}
